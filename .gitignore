.env

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# Data — raw downloads and derived tables are reproducible, keep them out of git
data/*.csv
data/processed/
!data/manual_news.csv

# Backtest artefacts are regenerated by run_all.R
output/figures/
output/models.rds
output/backtest_predictions.csv
output/backtest_bets.csv
output/backtest_summary.csv
output/diagnostics_segments.csv

# NOT ignored: output/track_record.csv
# The forward-test log is the point of the project. Committing it is what makes
# the record auditable — a timestamped prediction you can't show is worthless.

.DS_Store

# Working notes from build sessions -- handoff context, not part of the repo's
# public story. README.md and RUNBOOK.md carry what a reader actually needs.
SESSION_CONTEXT.md

# ESPN session cookies — never commit these
.espn-fantasy.env
*.env
__pycache__/

# Josh Lloyd / Locked On transcripts — third-party content, not ours to MIT-license.
# Kept on disk because lloyd.sh, verify.py quote and the alias expansion all read from
# here; just not redistributed. README.md stays tracked so the directory is documented.
fantasy/transcripts/*.txt
# Transcript index built from those transcripts — same reason, same rule.
# Reproduce locally with: python3 fantasy/index_lloyd.py
fantasy/lloyd.db
